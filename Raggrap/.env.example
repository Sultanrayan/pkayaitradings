# AI API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LLM Configuration
MAIN_LLM_MODEL=gpt-4o
CRITIC_LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2000

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Cache Settings
CACHE_TTL=3600
ENABLE_CACHE=true

# Vector Database (ChromaDB)
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=raggrap_embeddings

# Application Settings
APP_NAME=RagGrap
APP_VERSION=1.0.0
LOG_LEVEL=INFO
ENVIRONMENT=development

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# SpaCy Model
SPACY_MODEL=en_core_web_sm

# Performance Tuning
MAX_RELATED_MISTAKES=5
MAX_RETRIES=3
RETRY_DELAY=1
