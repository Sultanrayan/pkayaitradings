# =============================================================================
# Pkay TDAI — production environment
# Copy to `.env.production` on the server and fill in. `.env.production` is
# git-ignored; this template is safe to commit.
#
# Redeploy with:  bash deploy/redeploy.sh
#   (or: docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build)
# =============================================================================

# --- Required ---
# Generate:  python -c "import secrets;print(secrets.token_urlsafe(48))"
AUTH_SECRET=change-me-to-a-long-random-string

# --- Public URLs (single-origin deploy behind Caddy) ---
FRONTEND_URL=https://trade.pkay.fun
NEXT_PUBLIC_API_BASE_URL=https://trade.pkay.fun

# --- Google OAuth ---
# Add BOTH of these in Google Cloud Console → OAuth client:
#   Authorized redirect URI:  https://trade.pkay.fun/api/v1/auth/google/callback
#   Authorized JS origin:     https://trade.pkay.fun
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://trade.pkay.fun/api/v1/auth/google/callback

# --- Brevo transactional email (developer access tokens) ---
# Brevo → SMTP & API → API Keys. Starts with `xkeysib-`.
BREVO_API_KEY=
EMAIL_SENDER=no-reply@pkay.fun
EMAIL_SENDER_NAME=Pkay TDAI
PUBLIC_BASE_URL=https://trade.pkay.fun
LOGO_URL=https://trade.pkay.fun/logo-pkay.jpg
# Optional SMTP fallback (only used when BREVO_API_KEY is empty).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_LOGIN=
SMTP_PASSWORD=

# --- Admin console allowlist ---
ADMIN_EMAILS=menmengleapx1@gmail.com

# --- Cloudflare Turnstile (bot check on registration / applications) ---
# Keys from dash.cloudflare.com → Turnstile. Empty disables the check.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Khpay KHQR payments (plan upgrades) ---
# Key from khpay.site (ak_...). Empty disables checkout.
KHPAY_API_KEY=
KHPAY_BASE_URL=https://khpay.site/api/v1

# --- LLM used by the four agents (optional) ---
LLM_PROVIDER=none
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Decision engine & circuit breaker (defaults are fine) ---
# "weighted" = arithmetic weighted sum (legacy); "geometric" = weighted
# geometric mean with hard consistency rules (recommended).
DECISION_AGGREGATION=geometric
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=300

# --- Intelligence layer (backend-v2, Problems 7-10; defaults are fine) ---
ORDER_FLOW_ENABLED=true
EPISODIC_MEMORY_ENABLED=true
HMM_REGIME_ENABLED=true
LLM_REVIEW_ENABLED=true
LLM_REVIEW_ADJUSTMENT_MAX=0.10
