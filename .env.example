# =============================================================================
# Pkay TDAI — environment configuration
# Copy to `.env` and adjust. Every value below has a sane default in
# `shared/config.py`; only override what you need.
# =============================================================================

# --- Runtime ---
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

# --- Database (PostgreSQL + TimescaleDB) ---
POSTGRES_URL=postgresql+asyncpg://trading:trading@localhost:5432/trading

# --- Redis (message bus + cache) ---
REDIS_URL=redis://localhost:6379/0

# --- Qdrant (news embeddings) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- biquote (free, no API key required) ---
BIQUOTE_BASE_URL=https://biquote.io
BIQUOTE_TIMEOUT_SECONDS=10
BIQUOTE_MAX_RETRIES=3
BIQUOTE_REQUESTS_PER_MINUTE=15000

# --- Symbols & timeframes ---
TRADING_SYMBOLS=XAUUSD,BTCUSD
ANALYSIS_TIMEFRAMES=M5,H1,H4
PRIMARY_TIMEFRAME=H1

# --- LLM ---
# Provider: "openai" (any OpenAI-compatible endpoint) | "anthropic" | "none".
# "none" falls back to the deterministic lexicon/template behaviour.
LLM_PROVIDER=none
LLM_MODEL=gpt-4o-mini
# Base URL of the OpenAI-compatible gateway (e.g. https://api.relaymodels.com/v1).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Email (Brevo transactional email HTTP API) ---
# Preferred over SMTP. Get an API key from Brevo -> SMTP & API -> API Keys.
BREVO_API_KEY=
EMAIL_SENDER=no-reply@pkay.fun
EMAIL_SENDER_NAME=Pkay TDAI
PUBLIC_BASE_URL=https://trade.pkay.fun
LOGO_URL=https://trade.pkay.fun/logo-pkay.jpg
# Fallback SMTP relay (used only when BREVO_API_KEY is empty).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_LOGIN=
SMTP_PASSWORD=

# --- Admin ---
# Comma-separated allowlist of admin emails (case-insensitive).
ADMIN_EMAILS=menmengleapx1@gmail.com

# --- Broker / execution ---
# Broker: "paper" | "mt5" | "binance"
BROKER=paper
PAPER_INITIAL_BALANCE=100000
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Risk limits ---
MAX_DRAWDOWN_PCT=0.05
MAX_POSITION_SIZE=0.5
VAR_CONFIDENCE=0.95
VAR_LIMIT_PCT=0.02
CORRELATION_WARN_THRESHOLD=0.7
KELLY_FRACTION=0.25
RISK_FREE_RATE=0.0

# --- Decision engine ---
WEIGHT_TECHNICAL=0.45
WEIGHT_NEWS=0.25
WEIGHT_RISK=0.30
DECISION_BUY_THRESHOLD=0.65
DECISION_SKIP_THRESHOLD=0.35
# "weighted" = arithmetic weighted sum (legacy); "geometric" = weighted
# geometric mean with hard consistency rules (recommended).
DECISION_AGGREGATION=geometric

# --- Circuit breaker (per-agent resilience) ---
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=300

# --- Intelligence layer (backend-v2, Problems 7-10) ---
ORDER_FLOW_ENABLED=true
EPISODIC_MEMORY_ENABLED=true
HMM_REGIME_ENABLED=true
LLM_REVIEW_ENABLED=true
ORDER_FLOW_DELTA_WINDOW=20
ORDER_FLOW_DIVERGENCE_LOOKBACK=30
MEMORY_RECALL_K=10
MEMORY_MIN_SAMPLES=5
MEMORY_SCORE_ADJUSTMENT_MAX=0.10
HMM_N_STATES=4
HMM_N_ITER=50
HMM_N_RESTARTS=3
HMM_MIN_OBSERVATIONS=40
LLM_REVIEW_ADJUSTMENT_MAX=0.10

# --- Scheduler (Celery) ---
ANALYSIS_INTERVAL_SECONDS=300

# --- API gateway ---
# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Serve FastAPI's /docs, /redoc and /openapi.json. Keep false in production so
# the API surface is not enumerable from the browser.
EXPOSE_API_DOCS=false

# --- Auth ---
# When true, every /api/v1 endpoint requires a bearer token (sign in first).
# Set to false for unattended local testing (no login/registration forced).
AUTH_REQUIRED=true
# CHANGE ME in production: signs session and API access tokens.
AUTH_SECRET=pkay-dev-insecure-secret-change-me
AUTH_TOKEN_TTL_SECONDS=86400
# Where the browser is sent after a successful Google sign-in.
FRONTEND_URL=http://localhost:3000

# --- RAG engine (GraphRAG self-improvement layer, /api/v1/raggrap) ---
# Reuses the LLM settings above for correction guardrails. Disable entirely with
# RAGGRAP_ENABLED=false.
RAGGRAP_ENABLED=true
RAGGRAP_MAIN_LLM_MODEL=gpt-4o
RAGGRAP_CRITIC_LLM_MODEL=gpt-4o-mini
RAGGRAP_MAX_RELATED_MISTAKES=5
RAGGRAP_CACHE_ENABLED=true
RAGGRAP_CACHE_TTL=3600

# --- Cloudflare Turnstile (bot check on registration / applications) ---
# Keys from dash.cloudflare.com → Turnstile. Empty disables the check.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
